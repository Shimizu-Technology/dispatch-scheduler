# Frontend Clerk key, used by web/.env.local in local development.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Rails Clerk JWT verification. Set either CLERK_JWKS_URL or CLERK_DOMAIN.
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
# CLERK_DOMAIN=your-clerk-domain

# Optional access/role controls. Comma-separated, lower/upper case both work.
CLERK_ALLOWED_EMAILS=dispatcher@example.com,viewer@example.com
CLERK_ALLOWED_DOMAINS=jmiguam.com,shimizutechnology.com
CLERK_ADMIN_EMAILS=admin@example.com
CLERK_DISPATCHER_EMAILS=dispatcher@example.com

# Local dev only. Used when Clerk env vars are absent.
DEV_AUTH_ROLE=admin
