# Frontend env, used by web/.env.local in local development.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_API_URL=http://localhost:3000
# Optional: set when using a Clerk custom JWT template instead of custom session token claims.
# VITE_CLERK_JWT_TEMPLATE=dispatch-scheduler

# Rails env, used by api/.env or the Rails process environment.
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated extra browser origins when needed.
# CORS_ORIGINS=http://127.0.0.1:5173

# Rails Clerk JWT verification. Set either CLERK_JWKS_URL or CLERK_DOMAIN.
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
# CLERK_DOMAIN=your-clerk-domain
CLERK_SECRET_KEY=sk_test_your_secret_key
# CLERK_JWKS_TIMEOUT_SECONDS=3
# CLERK_API_TIMEOUT_SECONDS=3

# Bootstrap/recovery only. Use the in-app Users section for normal role changes.
CLERK_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
